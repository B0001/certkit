# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Test and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Lean
lean/**/build/
lean/**/.lake/

# CLI output
out/

# beads: the embedded Dolt database is local state, not source. The portable
# form is the JSONL export -- see issues.jsonl at the repo root.
.beads/
.beads.gate.lock

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Sandbox run output. sandbox-handoffs/ is deliberately NOT ignored: the
# handoff is the only durable account of how a bead was actually done, and the
# container that wrote it is disposable. Ignoring it meant every worker was
# told "the file is the part that survives" while it survived nowhere.
.sandbox.lock/
